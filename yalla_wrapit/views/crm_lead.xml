<odoo>
    <!-- Inherit the standard CRM Lead form -->
    <record id="crm_lead_form_inherit_top_design" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.top.design</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
<xpath expr="//header" position="inside">
    <button name="action_create_quotation"
            type="object"
            string="Create Quotation"
            class="btn-primary"
            icon="fa-file-text-o"/>
       <button name="action_print_master_inspection_report"
            type="object"
            string="Inspection Report"
            class="btn-primary"
            icon="fa-print"/>

</xpath>
            <!-- Insert our full notebook after the first group of fields -->
           <xpath expr="//page[@name='lead']" position="after">

                    <page string="Information Report">
                              <group string="Inspection Report" col="4">
                    <field name="report_name"/>
                    <field name="client_id"/>
                    <field name="prepared_by"/>
                    <field name="conducted_on"/>
                    <field name="location"/>
                </group>
                    </page>
                     <page string="Costing / BOQ" invisible="1">

                <!-- ===================== -->
                <!-- LABOUR SECTION -->
                <!-- ===================== -->
                <group string="Labour Cost" invisible="1">

                    <group>
                        <field name="labor_cost_per_day"/>
                        <field name="labor_workers"/>
                        <field name="labor_days"/>
                    </group>

                    <group>
                        <field name="labor_total" readonly="1"/>
                    </group>

                </group>

                <!-- ===================== -->
                <!-- MATERIAL SECTION -->
                <!-- ===================== -->


                <!-- ===================== -->
                <!-- TOTAL & MARGIN -->
                <!-- ===================== -->
                <group string="Total and Margin">

                    <group>
                        <field name="total_cost" readonly="1"/>
                        <field name="margin_percent"/>
                    </group>

                    <group>
                        <field name="final_price" readonly="1"/>
                    </group>

                </group>

            </page>
                    <!-- Kitchen Inspections -->
                    <page string="Kitchen">
                        <field name="kitchen_ids">
                            <list>
                                <field name="kitchen_cabinet_code"/>
                                <field name="kitchen_cabinet_qty"/>
                                <field name="kitchen_cabinet_type"/>
                                <field name="kitchen_countertop_code"/>
                            </list>
                            <form>
    <sheet>

        <notebook>

            <!-- ================= CABINET ================= -->
            <page string="Cabinet">
                <group col="4">
                    <field name="kitchen_cabinet_code"/>
                    <field name="kitchen_cabinet_type"/>

                    <field name="kitchen_cabinet_qty"/>

                    <field name="kitchen_cabinet_price"/>
                    <field name="formula_kitchen"/>


                    <field name="kitchen_cabinet_width"/>
                    <field name="kitchen_cabinet_height"/>
                    <field name="kitchen_cabinet_meters"/>
                    <field name="kitchen_cabinet_labour"/>


                    <field name="kitchen_cabinet_cleaning"/>
                    <field name="kitchen_cabinet_peeled_off"/>
                    <field name="kitchen_cabinet_hard_frame"/>
                    <field name="kitchen_cabinet_free_handles"/>

                    <field name="kitchen_cabinet_change_handles_size"/>
                    <field name="kitchen_attachment_ids" widget="many2many_binary"
                     context="{'default_res_model': 'yallawrap.kitchen'}"/>


                </group>
            </page>

            <!-- ================= COUNTERTOP ================= -->
            <page string="Countertop">
                <group col="4">
                    <field name="kitchen_countertop_code"/>
                    <field name="kitchen_countertop_qty"/>
                    <field name="kitchen_countertop_price"/>
                    <field name="formula_countertop"/>
                    <field name="kitchen_countertop_condition_notes"/>
                    <field name="kitchen_countertop_width"/>
                    <field name="kitchen_countertop_height"/>
                    <field name="kitchen_countertop_meters"/>
                    <field name="kitchen_countertop_labour"/>
                    <field name="kitchen_countertop_price_type"/>
                    <field name="kitchen_countertop_condition"/>

                    <field name="kitchen_countertop_condition_notes"/>
                    <field name="kitchen_countertop_attachment_ids" widget="many2many_binary"/>

                </group>
            </page>

            <!-- ================= BACKSPLASH ================= -->
            <page string="Backsplash">
                <group col="4">
                    <field name="backsplash_countertop_code"/>
                    <field name="backsplash_countertop_qty"/>
                    <field name="backsplash_countertop_price"/>
                    <field name="formula_backsplash"/>
                    <field name="backsplash_countertop_width"/>
                    <field name="backsplash_countertop_height"/>
                    <field name="backsplash_countertop_meters"/>
                    <field name="backsplash_countertop_labour"/>

                    <field name="backsplash_wall"/>
                    <field name="backsplash_countertop_attachment_ids" widget="many2many_binary"/>

                </group>
            </page>

            <!-- ================= FORMULA ================= -->
            <page string="Flooring">
    <field name="flooring_ids"/>

</page>



        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Bathroom Inspections -->
                    <page string="Bathroom">
                        <field name="bathroom_ids">
                            <list>
                                <field name="name"/>
                                <field name="type"/>
                                <field name="cabinet_code"/>
                                <field name="floor_code"/>
                            </list>
                          <form>
    <sheet>

        <notebook>

            <!-- ================= WALL & FLOOR ================= -->
            <page string="Wall and Floor">
                <group col="4">

                    <!-- General -->
                    <field name="name"/>
                    <field name="type"/>

                    <!-- Wall -->
                    <field name="wall_code"/>
                    <field name="wall_qty"/>
                    <field name="wall_type"/>
                    <field name="formula_wall"/>
                    <field name="wall_width"/>
                    <field name="wall_height"/>
                    <field name="wall_meters"/>
                    <field name="wall_price"/>
                    <field name="wall_labour"/>
                    <field name="wall_attachment_ids" widget="many2many_binary"/>

                    <!-- Floor -->


                </group>
            </page>

            <!-- ================= COUNTERTOP ================= -->
            <page string="Countertop">
                <group col="4">
                    <field name="countertop_code"/>
                    <field name="countertop_qty"/>

                    <field name="countertop_price"/>

                    <field name="countertop_width"/>
                    <field name="countertop_height"/>
                    <field name="countertop_meters"/>
                    <field name="countertop_labour"/>
                    <field name="countertop_condition"/>
                    <field name="countertop_condition_notes"/>
                    <field name="countertop_attachment_ids" widget="many2many_binary"/>
                </group>
            </page>
                <page string="Flooring">
    <field name="flooring_ids"/>

</page>
            <!-- ================= CABINET ================= -->
            <page string="Cabinet">
                <group col="4">
                    <field name="cabinet_code"/>
                    <field name="cabinet_qty"/>

                    <field name="cabinet_width"/>
                    <field name="cabinet_height"/>
                    <field name="cabinet_meters"/>
                   <field name="cabinet_labour"/>
                    <field name="cabinet_type"/>

                    <field name="cabinet_price"/>
                    <field name="formula_cabinet"/>
                    <field name="cabinet_attachment_ids"  widget="many2many_binary"/>
                </group>
            </page>



        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Wardrobe Inspections -->
                    <page string="Wardrobe">
                        <field name="wardrobe_ids">
                            <list>
                                <field name="wardrobe_code"/>
                                <field name="wardrobe_qty"/>
                                <field name="shutter_height"/>
                            </list>
                            <form>
    <sheet>

        <notebook>

            <!-- ================= WARDROBE ================= -->
            <page string="Wardrobe">
                <group col="4">
                    <field name="wardrobe_code"/>
                    <field name="wardrobe_qty"/>

                    <field name="wardrobe_price"/>

                    <field name="wardrobe_width"/>
                    <field name="wardrobe_height"/>
                    <field name="wardrobe_meters"/>
                    <field name="wardrobe_labour"/>
                    <field name="wardrobe_height_selection"/>
                    <field name="wardrobe_needs_cutting"/>
                    <field name="formula_wardrobe"/>
                    <field name="wardrobe_attachment_ids" widget="many2many_binary"/>
                </group>
            </page>

            <!-- ================= SHUTTERS ================= -->
            <page string="Shutters">
                <group col="4">
                    <field name="Type_of_Shutter_Multiple_choice"/>
                    <field name="shutter_height"/>
                    <field name="needs_cutting"/>
                </group>
            </page>

            <!-- ================= FORMULA ================= -->



        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Door Inspections -->
                    <page string="Door">
                        <field name="door_ids">
                            <list>
                                <field name="door_code"/>
                                <field name="door_qty"/>
                                <field name="door_size"/>
                            </list>
                           <form>
    <sheet>

        <notebook>

            <!-- ================= DOOR ================= -->
            <page string="Door">
                <group col="4">
                    <field name="door_code"/>
                    <field name="door_qty"/>

                    <field name="door_price"/>

                    <field name="door_width"/>
                    <field name="door_height"/>
                    <field name="door_meters"/>
                    <field name="door_labour"/>
                    <field name="door_size"/>
                    <field name="formula_door"/>
                </group>
            </page>

            <!-- ================= CONFIGURATION ================= -->
            <page string="Configuration">
                <group col="4">
                    <field name="Type_of_doors_Multiple_choice"/>
                    <field name="door_needs_scaffolding_door"/>
                    <field name="door_needs_cutting"/>

                </group>
            </page>

            <!-- ================= FORMULA ================= -->

                    <page string="Attachments">
    <group>
        <field name="door_attachment_ids" widget="many2many_binary"/>
    </group>
</page>

        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Flooring -->
                    <page string="Flooring">
                        <field name="flooring_ids">
                            <list>
                                <field name="floor_code"/>
                                <field name="floor_qty"/>
                                <field name="type"/>
                            </list>
                            <form>
    <sheet>

        <notebook>

            <!-- ================= FLOOR ================= -->
            <page string="Floor">
                <group col="4">
                    <field name="floor_code"/>
                    <field name="floor_qty"/>

                    <field name="floor_price"/>


                    <field name="floor_meters"/>
                    <field name="floor_labour"/>
                    <field name="type"/>
                    <field name="formula_floor"/>
                    <field name="floor_attachment_ids" widget="many2many_binary"/>

                </group>
            </page>

            <!-- ================= FORMULA ================= -->
            <page string="BOQ / Formula">
                <group>
                    <field name="formula_floor"/>
                </group>
            </page>


        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Window Frames -->
                    <page string="Window Frames">
                        <field name="window_frame_ids">
                            <list>
                                <field name="window_frame_code"/>
                                <field name="window_frame_qty"/>
                                <field name="window_frame_condition"/>
                            </list>
                            <form>
    <sheet>

        <notebook>

            <!-- ================= WINDOW FRAME ================= -->
            <page string="Window Frame">
                <group col="4">
                    <field name="window_frame_code"/>
                    <field name="window_frame_qty"/>

                    <field name="window_frame_price"/>

                    <field name="window_frame_width"/>
                    <field name="window_frame_height"/>
                    <field name="window_frame_meters"/>
                    <field name="window_frame_labour"/>
                    <field name="window_frame_condition"/>
                    <field name="window_frame_needs_scaffolding"/>
                </group>
            </page>

            <!-- ================= FORMULA ================= -->
            <page string="BOQ / Formula">
                <group>
                    <field name="formula_window_frame"/>
                </group>
            </page>
                         <page string="Attachments">
    <group>
        <field name="window_attachment_ids" widget="many2many_binary"/>
    </group>
</page>
        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Furniture -->
                    <page string="Furniture">
                        <field name="furniture_ids">
                            <list>
                                <field name="furniture_code"/>
                                <field name="furniture_qty"/>
                                <field name="furniture_type"/>
                            </list>
                            <form>
    <sheet>

        <notebook>

            <!-- ================= FURNITURE DETAILS ================= -->
            <page string="Furniture">
                <group col="4">
                    <field name="furniture_code"/>
                    <field name="furniture_qty"/>
                    <field name="furniture_price_type"/>
                    <field name="furniture_price"/>

                    <field name="furniture_width"/>
                    <field name="furniture_height"/>
                    <field name="furniture_meters"/>
                    <field name="furniture_meters_labour"/>
                    <field name="furniture_type"/>
                    <field name="furniture_attachment_ids" widget="many2many_binary"/>

                </group>
            </page>

            <!-- ================= FORMULA / BOQ ================= -->
            <page string="BOQ / Formula">
                <group>
                    <field name="formula_furniture"/>
                </group>
            </page>

        </notebook>

    </sheet>
</form>
                        </field>
                    </page>

                    <!-- Skirting -->
                    <page string="Skirting">
                        <field name="skirting_ids">
                            <list>
                                <field name="skirting_code"/>
                                <field name="skirting_qty"/>
                                <field name="type"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="skirting_code"/>
                                        <field name="skirting_qty"/>
                                        <field name="type"/>
                                        <field name="formula_skirting"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>

                    <!-- Attachments -->



            </xpath>

        </field>
    </record>
</odoo>