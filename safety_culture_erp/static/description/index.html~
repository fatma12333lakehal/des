<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Safety Culture ERP - Odoo Module</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
    }

    body{
        font-family:Arial, sans-serif;
        background:#f4f7fb;
        color:#333;
        line-height:1.6;
    }

    /* =========================
       TOP HERO SECTION
    ========================== */

    .hero{
        background:linear-gradient(135deg,#714B67,#875A7B);
        padding:90px 20px;
        text-align:center;
        color:white;
        position:relative;
        overflow:hidden;
    }

    .hero:before{
        content:'';
        position:absolute;
        width:400px;
        height:400px;
        background:rgba(255,255,255,0.05);
        border-radius:50%;
        top:-150px;
        right:-100px;
    }

    .hero:after{
        content:'';
        position:absolute;
        width:300px;
        height:300px;
        background:rgba(255,255,255,0.04);
        border-radius:50%;
        bottom:-120px;
        left:-100px;
    }

    .hero-content{
        position:relative;
        z-index:2;
    }

    .icon-box{
        display:inline-block;
        background:white;
        padding:14px;
        border-radius:24px;
        box-shadow:0 15px 35px rgba(0,0,0,0.25);
        margin-bottom:25px;
    }

    .icon-box img{
        width:130px;
        height:130px;
        border-radius:18px;
        display:block;
    }

    .hero h1{
        font-size:42px;
        margin-bottom:15px;
        font-weight:700;
    }

    .line{
        width:90px;
        height:4px;
        background:white;
        margin:20px auto;
        border-radius:10px;
        opacity:0.8;
    }

    .hero p{
        max-width:950px;
        margin:auto;
        font-size:17px;
        line-height:1.9;
        opacity:0.95;
    }

    .badges{
        margin-top:30px;
    }

    .badge{
        display:inline-block;
        background:rgba(255,255,255,0.15);
        padding:8px 16px;
        border-radius:25px;
        margin:5px;
        font-size:13px;
        backdrop-filter:blur(5px);
    }

    /* =========================
       SECTION
    ========================== */

    .section{
        max-width:1150px;
        margin:auto;
        padding:70px 20px;
    }

    .section-title{
        text-align:center;
        margin-bottom:45px;
    }

    .section-title h2{
        font-size:32px;
        color:#714B67;
        margin-bottom:12px;
    }

    .section-title p{
        color:#666;
        font-size:16px;
    }

    /* =========================
       CARDS
    ========================== */

    .cards{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
        gap:20px;
    }

    .card{
        background:white;
        border-radius:18px;
        padding:25px;
        box-shadow:0 4px 18px rgba(0,0,0,0.06);
        transition:0.3s;
    }

    .card:hover{
        transform:translateY(-6px);
    }

    .card i{
        font-size:28px;
        color:#875A7B;
        margin-bottom:15px;
    }

    .card h3{
        color:#714B67;
        margin-bottom:12px;
        font-size:20px;
    }

    .card p{
        color:#555;
        font-size:14px;
        line-height:1.7;
    }

    /* =========================
       FEATURES
    ========================== */

    .features{
        background:white;
        padding:70px 20px;
    }

    .feature-box{
        max-width:1100px;
        margin:auto;
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
        gap:25px;
    }

    .feature{
        background:#f8f8fc;
        border-left:5px solid #875A7B;
        padding:22px;
        border-radius:14px;
    }

    .feature h4{
        margin-bottom:10px;
        color:#714B67;
        font-size:18px;
    }

    /* =========================
       FOOTER
    ========================== */

    footer{
        background:#1f1f1f;
        color:white;
        text-align:center;
        padding:25px;
        margin-top:50px;
    }

</style>

</head>

<body>

<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <div class="icon-box">
            <img src="icon.png" alt="Safety Culture ERP">
        </div>

        <h1>🛡️ Safety Culture ERP</h1>

        <div class="line"></div>

        <p>
            🚀 A modern and fully dynamic ERP solution designed for Sales Engineers,
            combining BOQ-based estimation, intelligent project reporting,
            and advanced engineering workflow management in one unified platform.
            <br><br>
            🇫🇷 Module ERP moderne destiné aux ingénieurs commerciaux,
            intégrant le chiffrage BOQ, le reporting intelligent
            et la gestion multi-métiers des projets.
        </p>

        <div class="badges">
            <span class="badge">Odoo ERP</span>
            <span class="badge">BOQ Management</span>
            <span class="badge">Engineering</span>
            <span class="badge">Reporting</span>
            <span class="badge">Sales Engineers</span>
        </div>

    </div>

</section>

<!-- ================= BUSINESS DOMAINS ================= -->

<section class="section">

    <div class="section-title">
        <h2>🌐 Business Domains</h2>
        <p>Complete engineering and project costing platform</p>
    </div>

    <div class="cards">

        <div class="card">
            <i class="fa-solid fa-helmet-safety"></i>
            <h3>Sales Engineering</h3>
            <p>
                Project lifecycle management, technical reporting,
                quotation generation and engineering coordination.
            </p>
        </div>

        <div class="card">
            <i class="fa-solid fa-kitchen-set"></i>
            <h3>Kitchen Solutions</h3>
            <p>
                Custom kitchen design, BOQ calculation
                and intelligent material selection.
            </p>
        </div>

        <div class="card">
            <i class="fa-solid fa-bath"></i>
            <h3>Bathroom Solutions</h3>
            <p>
                Sanitary system design, equipment specification
                and project cost estimation.
            </p>
        </div>

        <div class="card">
            <i class="fa-solid fa-door-open"></i>
            <h3>Doors & Joinery</h3>
            <p>
                Joinery management, door specifications
                and production tracking workflow.
            </p>
        </div>

        <div class="card">
            <i class="fa-solid fa-border-all"></i>
            <h3>Flooring</h3>
            <p>
                Surface calculation, flooring optimization
                and material management system.
            </p>
        </div>

        <div class="card">
            <i class="fa-solid fa-couch"></i>
            <h3>Furniture</h3>
            <p>
                Custom furniture management,
                catalogs and automated costing tools.
            </p>
        </div>

    </div>

</section>

<!-- ================= FEATURES ================= -->

<section class="features">

    <div class="section-title">
        <h2>⚙️ Advanced Features</h2>
        <p>Powerful tools for engineering and reporting</p>
    </div>

    <div class="feature-box">

        <div class="feature">
            <h4>📊 Dynamic Reporting</h4>
            <p>
                Generate intelligent inspection reports
                and advanced project analytics in real time.
            </p>
        </div>

        <div class="feature">
            <h4>🧮 BOQ Integration</h4>
            <p>
                Automatic quantity calculation and
                engineering cost estimation engine.
            </p>
        </div>

        <div class="feature">
            <h4>📁 Project Management</h4>
            <p>
                Centralized project workflow with
                engineering follow-up and task monitoring.
            </p>
        </div>

        <div class="feature">
            <h4>📈 Smart Dashboards</h4>
            <p>
                Interactive dashboards and KPI tracking
                for sales engineers and managers.
            </p>
        </div>

    </div>

</section>

<!-- ================= FOOTER ================= -->

<footer>
    © 2026 Safety Culture ERP - Odoo Module | All Rights Reserved
</footer>

</body>
</html>
