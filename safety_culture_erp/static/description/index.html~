<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Safety Culture - Odoo ERP Module</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
    body{
        margin:0;
        font-family: Arial, sans-serif;
        background:#f4f7fb;
        color:#333;
    }

    /* ===== TOP COVER ===== */
    .cover{
        background: linear-gradient(135deg,#714B67,#875A7B);
        text-align:center;
        padding:70px 20px;
        color:white;
    }

    .icon-wrapper{
        display:flex;
        justify-content:center;
        margin-bottom:18px;
    }

    .icon-box{
        background:white;
        padding:12px;
        border-radius:22px;
        box-shadow:0 15px 30px rgba(0,0,0,0.25);
    }

    .icon-box img{
        width:120px;
        height:120px;
        border-radius:16px;
    }

    .cover h1{
        margin:0;
        font-size:36px;
    }

    .cover p{
        max-width:900px;
        margin:18px auto 0 auto;
        font-size:16px;
        line-height:1.8;
        opacity:0.95;
    }

    .badges{
        margin-top:25px;
    }

    .badge{
        display:inline-block;
        background:rgba(255,255,255,0.18);
        padding:7px 14px;
        border-radius:25px;
        font-size:12px;
        margin:4px;
    }

    /* ===== SECTION ===== */
    .section{
        max-width:1100px;
        margin:auto;
        padding:50px 20px;
    }

    .section h2{
        text-align:center;
        font-size:26px;
        margin-bottom:10px;
    }

    .section p{
        text-align:center;
        margin-bottom:30px;
        color:#555;
    }

    /* ===== CARD ===== */
    .card{
        background:white;
        padding:20px;
        margin-bottom:15px;
        border-radius:12px;
        box-shadow:0 2px 12px rgba(0,0,0,0.06);
        transition:0.3s;
    }

    .card:hover{
        transform:translateY(-4px);
    }

    .card h3{
        margin:0 0 10px 0;
        color:#714B67;
        font-size:18px;
    }

    /* ===== FOOTER ===== */
    footer{
        text-align:center;
        padding:20px;
        background:#222;
        color:white;
        margin-top:40px;
    }
</style>
</head>

<body>

<!-- ================= COVER ================= -->
<div class="cover">

    <div class="icon-wrapper">
        <div class="icon-box">
            <img src="icon.png" alt="Safety Culture ERP">
        </div>
    </div>

    <h1>🛡️ Safety Culture ERP</h1>

    <p>
        🚀 A powerful ERP solution designed for Sales Engineers with BOQ-based estimation,
        intelligent reporting, and multi-sector engineering management.
        <br><br>
        🇫🇷 Module ERP complet destiné aux ingénieurs commerciaux avec gestion BOQ,
        reporting intelligent et pilotage multi-métiers.
    </p>

    <div class="badges">
        <span class="badge">Odoo Module</span>
        <span class="badge">BOQ System</span>
        <span class="badge">Engineering ERP</span>
        <span class="badge">Smart Reporting</span>
    </div>

</div>

<!-- ================= CONTENT ================= -->
<div class="section">

    <h2>🌐 Business Domains / Métiers</h2>
    <p>All-in-one engineering & project management platform</p>

    <div class="card">
        <h3>🏗️ Sales Engineering</h3>
        <p>Project lifecycle management, technical reporting, client analysis and quotation generation.</p>
    </div>

    <div class="card">
        <h3>🍽️ Kitchen Solutions</h3>
        <p>Custom kitchen design, BOQ calculation and material selection.</p>
    </div>

    <div class="card">
        <h3>🚿 Bathroom Solutions</h3>
        <p>Sanitary system design, equipment selection and cost estimation.</p>
    </div>

    <div class="card">
        <h3>🚪 Doors & Joinery</h3>
        <p>Door specification management and production tracking.</p>
    </div>

    <div class="card">
        <h3>🪵 Flooring</h3>
        <p>Surface calculation and material optimization.</p>
    </div>

    <div class="card">
        <h3>🪑 Furniture</h3>
        <p>Custom furniture design and catalog management system.</p>
    </div>

    <div class="card">
        <h3>📊 BOQ Management</h3>
        <p>Automatic quantity calculation and cost generation engine.</p>
    </div>

    <div class="card">
        <h3>⚙️ Reporting System</h3>
        <p>Interactive dashboards and performance analytics.</p>
    </div>

</div>

<!-- ================= FOOTER ================= -->
<footer>
    © 2026 Safety Culture - Odoo ERP Module | All Rights Reserved
</footer>

</body>
</html>
