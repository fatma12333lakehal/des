<odoo>
    <!-- list (List) View -->
    <record id="view_yallawrap_tile_code_tree" model="ir.ui.view">
        <field name="name">yallawrap.tile.code.list</field>
        <field name="model">yallawrap.tile.code</field>
        <field name="arch" type="xml">
            <list string="Tile Codes">
                <field name="code"/>
                <field name="price_per_meter"/>
                <field name="price_per_roll"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_yallawrap_tile_code_form" model="ir.ui.view">
        <field name="name">yallawrap.tile.code.form</field>
        <field name="model">yallawrap.tile.code</field>
        <field name="arch" type="xml">
            <form string="Tile Code">
                <sheet>
                    <group>
                        <field name="code"/>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the list View -->
    <record id="action_yallawrap_tile_code" model="ir.actions.act_window">
        <field name="name">Tile Codes</field>
        <field name="res_model">yallawrap.tile.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Tile Code
            </p>
        </field>
    </record>


    <!-- Menu Item -->
    <menuitem id="menu_yallawrap_root" name="YallaWrap" sequence="10"/>
    <menuitem id="menu_yallawrap_tile_code" name="Tile Codes"
              parent="menu_yallawrap_root"
              action="action_yallawrap_tile_code" sequence="60"/>

</odoo>
